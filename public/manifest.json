{
  "manifest_version": 3,
  "name": "Tab Sorter",
  "version": "0.1.0",
  "description": "Sort tabs by title or hostname, with optional hostname groups. Pinned tabs stay untouched.",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "sort-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Sort and group tabs using saved settings"
    }
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Sort tabs"
  }
}
